# Gemini (Google AI Studio) — get your free key from: https://aistudio.google.com/apikey
# Free tier, no credit card required. Used when GEMINI_API_KEY is set.
GEMINI_API_KEY=your_gemini_key_here

# Groq (alternative LLM provider) — https://console.groq.com
# Free tier: 1,000 requests/day, no credit card required
GROQ_API_KEY=gsk_your_key_here
